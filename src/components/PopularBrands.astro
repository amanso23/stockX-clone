---
import SectionContainer from "@components/SectionContainer.astro";
import type { SimpleArticle } from "src/types";



const POPULAR_BRANDS: SimpleArticle[] = [
    {
        src: "/images/stockx/1-c0a5df54bc7d.jpg",
        href: "https://stockx.com/brands/jordan",
    },
    {
        src: "/images/stockx/2-ed7bb017e090.jpg",
        href: "https://stockx.com/brands/nike",
    },
    {
        src: "/images/stockx/3-9bf445ca6a96.jpg",
        href: "https://stockx.com/brands/louis-vuitton",
    },
    {
        src: "/images/stockx/5-7fa6b5ca8c7a.webp",
        href: "https://stockx.com/brands/ugg",
    },
    {
        src: "/images/stockx/4-4be4aee2ffff.webp",
        href: "https://stockx.com/brands/fear-of-god"
    },

]
    const link = {
        href: "https://stockx.com/brands",
        label: "See All →",
    }


---

<SectionContainer title="Popular Brands" link={link} titleClass="text-xl" >
        {POPULAR_BRANDS.map((article) => (
            <a href={article.href} >
                <img src={article.src} alt="Popular Brand" class="w-auto h-40 object-cover rounded-2xl" />
            </a>
        ))}
 

</SectionContainer>